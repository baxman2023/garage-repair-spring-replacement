{
  "name": "copyforge",
  "version": "0.1.0",
  "private": true,
  "description": "CopyForge — multi-tenant direct-response funnel generation SaaS",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @copyforge/web dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "produce": "pnpm --filter @copyforge/cli run dev --",
    "worker": "pnpm --filter @copyforge/worker run dev",
    "test": "pnpm -r run test"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "@tailwindcss/oxide"]
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "pm2": "^5.4.3",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}
