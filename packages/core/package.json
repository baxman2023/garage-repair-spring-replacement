{
  "name": "@copyforge/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./env": {
      "types": "./src/env.ts",
      "import": "./dist/env.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsup src/index.ts src/env.ts --format esm --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ulidx": "^2.4.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7"
  }
}
