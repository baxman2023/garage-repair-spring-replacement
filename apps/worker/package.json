    "@copyforge/core": "workspace:*",
    "@copyforge/db": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "vitest": "^3.0.2"
  }
}
